# PostgreSQL local ou conexao do pooler Supabase
DATABASE_URL=postgresql://corsa:corsa@localhost:5432/corsa

# Supabase Storage (chave secreta apenas no servidor; nunca use NEXT_PUBLIC_)
SUPABASE_URL=https://[PROJETO_ID].supabase.co
SUPABASE_SERVICE_ROLE_KEY=[CHAVE_SECRETA_DO_SUPABASE]

SESSION_SECRET=change-me-to-a-random-32-char-string
NEXT_PUBLIC_SITE_URL=http://localhost:3000
